# Storefront — public site

# Public site URL (used for canonical, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (offset port to avoid clashing with other Postgres on this machine)
DATABASE_URL=postgres://nasij:nasij@localhost:55432/nasij

# Redis (offset port)
REDIS_URL=redis://localhost:56379

# Search
MEILISEARCH_HOST=http://localhost:57700
MEILISEARCH_PUBLIC_KEY=

# Payments
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_SECRET_KEY=

# Email (Mailpit locally, offset)
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=51025

# Storage (MinIO locally, offset)
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=nasij
S3_SECRET_ACCESS_KEY=nasij-secret
S3_BUCKET=nasij

# Observability
SENTRY_DSN=
POSTHOG_KEY=
