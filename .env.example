# Root .env.example — copy to .env to override the docker-compose host ports.
#
# Default host ports are intentionally OFFSET from each service's standard port
# so the dev stack does not collide with other local servers you may be running.
# Edit any of the *_HOST_PORT vars to shift again.

POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
MEILI_HOST_PORT=57700
MAILPIT_SMTP_HOST_PORT=51025
MAILPIT_UI_HOST_PORT=58025
MINIO_API_HOST_PORT=59000
MINIO_CONSOLE_HOST_PORT=59001

# Per-app ports
STOREFRONT_PORT=3000
ADMIN_PORT=3001
POS_PORT=5173
GATEWAY_PORT=54000

# Connection URLs (used by every app's .env.local by default)
DATABASE_URL=postgres://nasij:nasij@localhost:55432/nasij
REDIS_URL=redis://localhost:56379
MEILISEARCH_HOST=http://localhost:57700
MEILISEARCH_MASTER_KEY=nasij-dev-master-key
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=nasij
S3_SECRET_ACCESS_KEY=nasij-secret
S3_BUCKET=nasij
SMTP_HOST=localhost
SMTP_PORT=51025
